function circle(l: location, r:number, t: entities=entities, limit: number=3) :: entities:
    loop {_t::*}:
        set {_e} to loop-value's location
        abs({_l}'s y - {_e}'s y) <= {_limit}
        set {_e}'s y to {_l}'s y
        distance between {_l} and {_e} <= {_r}
        add loop-value to {_e::*}
    return {_e::*}
function circle(l: location, r: number, p: color=blue, text: text=""):
    async run 0 tick later:
        loop {_r}*16 times:
            set {_v} to cylindrical vector radius {_r}, r(0, 360, false), height 0
            set {_c} to {_l} ~ {_v}
            force draw 1 {_p} dust particles of size 1 at {_c} for Players
function circle(l: location, r: number, p: particle,v: vector=vector(0,-0.5,0)):
    async run 0 tick later:
        loop {_r}*16 times:
            set {_v} to cylindrical vector radius {_r}, r(0, 360, false), height 0
            set {_c} to {_l} ~ {_v}
            force draw {_p} with velocity {_v} at {_c} for Players
            draw {_p} at {_c} for Players
function circle(l: location, r: number, p: color, e: entities) :: entities:
    loop 180 times:
        set {_v} to cylindrical vector radius {_r}, yaw loop-value*2, height 0
        set {_c} to {_l} ~ {_v}
        make 1 of dust using dustOption({_p}, 1) at {_c} with force
        add {_e::*} where [distance between location of input and {_c} <= 1] to {_o::*}
    return {_o::*}
function line(l: location,r: number,p: color={maxor}):
    loop {_r}*2 time:
        set {_v} to vector from yaw {_l}'s yaw and pitch {_l}'s pitch
        set {_v} to {_v} * loop-number/2
        force draw 1 {_p} dust particles of size 1 at {_l}~{_v} for players
function line(l: location,r: number,p: particle, t: text="") :: entities:
    loop {_r}*2 time:
        set {_v} to vector from yaw {_l}'s yaw and pitch {_l}'s pitch
        set {_v} to {_v} * loop-number/2
        force draw {_p} with velocity vector(0,0,0) at {_l}~{_v} for Players
function sphere(l: location, r: number,c: color=blue,t:text="") :: entities:
    async run 0 tick later:
        loop {_r}*32 time:
            set {_v} to spherical vector radius {_r}, r(0, 360, false), r(-90,90,false)
            set {_} to {_l} ~ {_v}
            force draw 1 {_c} dust particles of size 1 at {_} for Players
    return living entities in radius {_r} around {_l}
function sphere(l: location, r: number,p: particle) :: entities:
    async run 0 tick later:
        loop {_r}*32 time:
            set {_v} to spherical vector radius {_r}, r(0, 360, false), r(-90,90,false)
            set {_} to {_l} ~ {_v}
            force draw {_p} with velocity vector(0,0,0) at {_} for Players
    return living entities in radius {_r} around {_l}
function fan(l: location, r: number, angle: number, p: color):
    set {_pts::*} to conedata({_l}, {_r}, {_angle})
    loop {_pts::*}:
        make 1 of dust using dustOption({_p}, 2) at loop-value
function hfan(l: location, r: number, angle: number, p: color):
    set {_h} to {_angle} / 2
    set {_s} to (0.5 / {_r}) * 57.29578
    set {_v} to vector from yaw {_l}'s yaw - {_h} and pitch {_l}'s pitch
    set {_v} to {_v} * {_r}
    set {_e1} to {_l} ~ {_v}
    set {_v} to vector from yaw {_l}'s yaw + {_h} and pitch {_l}'s pitch
    set {_v} to {_v} * {_r}
    set {_e2} to {_l} ~ {_v}
    set {_pts::*} to ray({_l}, {_e1}, 0.5)
    loop {_pts::*}:
        make 1 of dust using dustOption({_p}, 2) at loop-value
    set {_pts::*} to ray({_l}, {_e2}, 0.5)
    loop {_pts::*}:
        make 1 of dust using dustOption({_p}, 2) at loop-value
    set {_n} to floor({_angle} / {_s})
    loop {_n} + 1 times:
        set {_y} to {_l}'s yaw - {_h} + {_s} * (loop-number - 1)
        set {_v} to vector from yaw {_y} and pitch {_l}'s pitch
        set {_v} to {_v} * {_r}
        make 1 of dust using dustOption({_p}, 2) at {_l} ~ {_v}
function rect(l: location, w: number, h: number, p: color):
    set {_f} to vector from yaw {_l}'s yaw and pitch 0
    set {_ri} to vector from yaw {_l}'s yaw + 90 and pitch 0
    set {_fv} to {_f} * ({_h} / 2)
    set {_rv} to {_ri} * ({_w} / 2)
    set {_nfv} to {_fv} * -1
    set {_nrv} to {_rv} * -1
    set {_c1} to {_l} ~ {_fv}
    set {_c1} to {_c1} ~ {_rv}
    set {_c2} to {_l} ~ {_fv}
    set {_c2} to {_c2} ~ {_nrv}
    set {_c3} to {_l} ~ {_nfv}
    set {_c3} to {_c3} ~ {_nrv}
    set {_c4} to {_l} ~ {_nfv}
    set {_c4} to {_c4} ~ {_rv}
    set {_pts::*} to ray({_c1}, {_c2}, 0.5)
    set {_e::*} to ray({_c2}, {_c3}, 0.5)
    add {_e::*} to {_pts::*}
    set {_e::*} to ray({_c3}, {_c4}, 0.5)
    add {_e::*} to {_pts::*}
    set {_e::*} to ray({_c4}, {_c1}, 0.5)
    add {_e::*} to {_pts::*}
    loop {_pts::*}:
        make 1 of dust using dustOption({_p}, 2) at loop-value
function fillcircle(l: location, r: number, p: color):
    set {_s} to 0.5
    set {_n} to floor({_r} / {_s})
    if {_n} > 20:
        set {_n} to 20
        set {_s} to {_r} / {_n}
    make 1 of dust using dustOption({_p}, 2) at {_l}
    loop {_n} times:
        set {_rr} to {_s} * loop-number-1
        set {_m} to floor({_rr} * 16)
        loop {_m} times:
            set {_v} to cylindrical vector radius {_rr}, loop-number-2 * 360 / {_m}, height 0
            set {_c} to {_l} ~ {_v}
            make 1 of dust using dustOption({_p}, 2) at {_c}
function rain(l: location, r: number, p: color):
    loop {_r}*4 times:
        set {_v} to cylindrical vector radius r(0, {_r}, false), r(0, 360, false), height 0
        set {_c} to {_l} ~ {_v}
        loop 6 times:
            make 1 of dust using dustOption({_p}, 2) at {_c}
            add -0.5 to {_c}'s y
function spherehalf(l: location, r: number, p: particle, c: color=red) :: entities:
    async run 0 tick later:
        loop {_r}*64 time:
            set {_v} to spherical vector radius {_r}, r(0, 360, false), r(-90,90,false)
            set {_} to {_l} ~ {_v}
            {_}'s y >= {_l}'s y
            if {_p} is dust:
                make 1 of dust using dustOption({_c}, 2) at {_}
            else:
                draw {_p} at {_} for players
    return living entities in radius {_r} around {_l}
