function txtDisplay(t: text, l: location, d: time span=20 tick, opa: number=-73) :: entity:
    spawn text display at {_l}
    set {_e} to last spawned text display
    set {_e}'s text to {_t}
    set color of {_e} to rgb(0,0,0,{_opa}) if {_opa} is not -73
    set billboard of {_e} to center
    make {_e} visible through walls
    make {_e} not persist
    set {textdisplay::%uuid of {_e}%} to {_d} later
    return {_e}

function bossbar(p: player, id: text, title: text, v: integer=100, c: color=white) :: bossbar:
    if {bossbars::%{_p}%::%{_title}%} is set:
        stop
    set {_b} to a {_c} boss bar titled colored {_title}
    set {bossbars::%{_p}%::%{_title}%} to {_b}
    add {_p} to viewers of {_b}
    set style of {_b} to solid
    progress({_b}, {_v})
    return {_b}

function progress(b: bossbar, progress: integer):
    set progress of {_b} to {_progress} / 100

function notify(p: player, title: text, time: integer=10, color: color=white, reverse: boolean=false):
    if {_reverse} is true:
        set {_b} to bossbar({_p}, {_title}, {_title}, 0, {_color})
        if {_b} is set:
            loop {_time} time:
                set {_} to loop-number * (100 / {_time})
                progress({_b}, {_})
                wait tick
                stop loop if {_p} is not online
                stop loop if {bossbars::%{_p}%::%{_title}%} is not set
            remove {_p} from viewers of {_b}
            delete {bossbars::%{_p}%::%{_title}%}
        else:
            progress({bossbars::%{_p}%::%{_title}%}, 0)
    else:
        set {_b} to bossbar({_p}, {_title}, {_title}, 100, {_color})
        if {_b} is set:
            loop {_time} time:
                set {_} to 100 - (loop-number) * (100 / {_time})
                progress({_b}, {_})
                wait tick
                stop loop if {_p} is not online
                stop loop if {bossbars::%{_p}%::%{_title}%} is not set
            remove {_p} from viewers of {_b}
            delete {bossbars::%{_p}%::%{_title}%}
        else:
            progress({bossbars::%{_p}%::%{_title}%}, 100)

function delbar(p: players, title: text):
    loop {_p::*}:
        set {_p} to loop-value
        remove {_p} from viewers of {bossbars::%{_p}%::%{_title}%}
        delete {bossbars::%{_p}%::%{_title}%}

function dcircle(l: location, r: number, c: color=red, d: time span=20 tick, through: boolean=false):
    set {_r} to {_r}*1.5
    spawn text display at {_l}
    set {_e} to last spawned text display
    set {_t} to "<%{_c}%>◯"
    set {_e}'s text to colored {_t}
    set transformation translation of {_e} to vector({_r}*-0.2,{_r}*-1.2 ,0)
    set billboard of {_e} to fixed
    set {_e}'s scale to vector({_r},{_r},1)*10
    set color of {_e} to rgb(0,0,0,0)
    make {_e} visible through walls if {_through} is true
    make {_e} not persist
    set text opacity of {_e} to 160
    set {_e}'s pitch to -90
    wait {_d}
    kill {_e}

function magic(target: entity, l: location, r: number, c: color=red, d: time span=20 tick, through: boolean=false):
    set {_r} to {_r}*1.5
    spawn text display at {_l}
    set {_e} to last spawned text display
    set {_t} to "<%{_c}%>┃'<'.┃/７┃\" 
    set {_e}'s text to colored {_t}
    set text opacity of {_e} to 128
    set transformation translation of {_e} to vector({_r}*-0.2,{_r}*-1.2 ,0)
    set billboard of {_e} to fixed
    set {_e}'s scale to vector({_r},{_r},1)*10
    set color of {_e} to rgb(0,0,0,0)
    make {_e} visible through walls if {_through} is true
    make {_e} not persist
    set {_e}'s pitch to -90
    set {_e}'s teleport duration to 3 tick
    loop {_d}'s ticks time:
        wait tick
        teleport {_e} to {_target}
        set {_e}'s pitch to -90
        add loop-number*360/({_d}'s ticks) to {_e}'s yaw
    kill {_e}

function bcastbar(t: text, time: integer):
    set {_id} to "%random uuid%"
    set {_b} to a white boss bar titled colored {_t}
    add all players to viewers of {_b}
    set style of {_b} to solid
    progress({_b}, 100)
    set {bcastbar::%{_id}%} to {_b}
    set {bcastbar::%{_id}%::time} to {_time}
    set {bcastbar::%{_id}%::left} to {_time}
    startTask("bcastbar", timespan({_time}, tick) + 2 seconds, {_id})

function Nanatask_bcastbar(id: text) :: boolean:
    set {_b} to {bcastbar::%{_id}%}
    if {_b} is not set:
        return true
    remove 1 from {bcastbar::%{_id}%::left}
    if {bcastbar::%{_id}%::left} <= 0:
        remove all players from viewers of {_b}
        delete {bcastbar::%{_id}%}
        delete {bcastbar::%{_id}%::*}
        return true
    set {_v} to {bcastbar::%{_id}%::left} * 100 / {bcastbar::%{_id}%::time}
    progress({_b}, {_v})
    return false

function hud(p: player, t: text, d: timespan=0 tick) :: entity:
    delhud({_p}) if {hud::%uuid of {_p}%} is set
    spawn text display at {_p}
    set {_e} to last spawned text display
    set text of {_e} to {_t}
    set billboard of {_e} to center
    make {_e} visible through walls
    make {_e} not persist
    set transformation translation of {_e} to vector from 0, 0.25, 0
    set view range of {_e} to 0.1
    make {_e} ride {_p}
    set {hud::%uuid of {_p}%} to {_e}
    if {_d}'s ticks > 0:
        set {_expire} to {_d} later
        set {hud::%uuid of {_p}%::end} to unix timestamp of {_expire}
        startTask("hud", {_d} + 2 seconds, "hud_%uuid of {_p}%")
    return {_e}

function sethud(p: player, t: text):
    if {hud::%uuid of {_p}%} is set:
        set text of {hud::%uuid of {_p}%} to {_t}

function delhud(p: player):
    if {hud::%uuid of {_p}%} is set:
        kill {hud::%uuid of {_p}%}
    delete {hud::%uuid of {_p}%::*}

function Nanatask_hud(id: text) :: boolean:
    set {_u} to {_id}
    replace "hud_" in {_u} with ""
    set {_p} to player({_u})
    if {_p} is not set:
        kill {hud::%{_u}%}
        delete {hud::%{_u}%::*}
        return true
    if {_p} is not online:
        delhud({_p})
        return true
    if unix timestamp of now >= {hud::%{_u}%::end}:
        delhud({_p})
        return true
    return false
