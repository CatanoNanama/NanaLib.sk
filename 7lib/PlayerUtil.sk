using reflection
function reset(p: players, tp: boolean=false, clinv: boolean=false):
    loop {_p::*}:
        set {_p} to loop-value
        clear {timer::%{_p}%::*}
        clearbuffs(loop-value)
        clear scoreboard tags of {_p}
        if {_tp} is true:
            {lib::spawn} is set
            teleport {_p} to {lib::spawn}
        clear potion effects of {_p}
        set gamemode of {_p} to adventure
        reset item cooldown of items for {_p}
        reset arrows stuck in {_p}
        reset display name of {_p}
        reset saturation of {_p}
        reset level progress of {_p}
        reset {_p}'s level
        reset {_p}'s food level
        loop all attribute types:
            reset loop-value-2 attribute of {_p}
        heal {_p} by infinity value
        set {_p}'s attack damage attribute to 1
        make {_p} visible
        make {_p} vulnerable
        reveal {_p} for all players
        set {_p}'s gravity to true
        reset velocity of {_p}
        set fall distance of {_p} to 0
        reset {_p}'s walk speed
        loop indices of {bossbars::%{_p}%::*}:
            delbar({_p}, loop-value-2)
        clear {_p}'s inventory if {_clinv} is true

function effects(target: players, p: potion effect type, tier: number=0, time: time span=0 tick):
    loop {_target::*}:
        set {_t} to loop-value
        add ambient potion effect of {_p} {_tier} for {_time} to potion effects of {_t}

function enemys(p: player) :: players:
    if team of {_p} is not set:
        return (all players where [gamemode of input is adventure]) where [input is not {_p}]
    set {_t} to team of {_p}
    if allow friendly fire team state of {_t} is true:
        return (all players where [gamemode of input is adventure]) where [input is not {_p}]
    loop all players:
        gamemode of loop-player is adventure or survival
        team of loop-player is not {_t}
        add loop-player to {_e::*}
    return {_e::*}

function teams(p: player) :: players:
    set {_t} to team of {_p}
    if {_t} is not set:
        return {_p}
    if allow friendly fire team state of {_t} is true:
        return {_p}
    loop players:
        gamemode of loop-player is survival or adventure
        team of loop-player is {_t}
        add loop-player to {_e::*}
    return {_e::*}

function gui(p: players, i: items, t: text, raw: integer=6):
    set {_gui} to new chest inventory with {_raw} row named {_t}
    loop {_i::*}:
        set slot loop-counter - 1 of {_gui} to loop-value
    open {_gui} to {_p::*}

function selectgui(p: player, handler: text=""):
    set {selecthandler::%uuid of {_p}%} to {_handler}
    set {_gui} to chest inventory with 6 rows named "対象を選択"
    loop all players:
        set slot loop-counter - 1 of {_gui} to loop-value's skull named "%loop-value%"
    open {_gui} to {_p}

on inventory click:
    event-inventory is not player's inventory
    event-slot is not empty
    name of event-inventory is "対象を選択"
    cancel event
    set {select::%uuid of player%} to player(name of event-item)
    if {selecthandler::%uuid of player%} is set:
        set {_h} to {selecthandler::%uuid of player%}
        if {_h} is not "":
            set {_f} to function named {_h}
            if {_f} is set:
                run {_f} with arguments player
    wait 1 tick
    close inventory for player

function sound(sound: text, l: location, t: players, pitch: number=1, volume: number=1, seed: integer=-1):
    if {_seed} is -1:
        play sound {_sound} at volume {_volume} at pitch {_pitch} on {_l} for {_t::*}
        stop
    play sound {_sound} with seed {_seed} at volume {_volume} at pitch {_pitch} on {_l} for {_t::*}

function soundradius(l: location, s: text, r: number=16):
    loop players in radius {_r} around {_l}:
        add loop-player to {_t::*}
    play sound {_s} at volume 1 at pitch 1 on {_l} for {_t::*}

function addyp(t: player, y: number, p: number):
    execute console command "/execute as %{_t}% at @s run tp @s ~ ~ ~ ~%{_y}% ~%{_p}%"

function nametag(p: player):
    spawn text display at {_p}
    set {_e} to last spawned entity
    add "nametag" to scoreboard tags of {_e}
    set transformation translation of {_e} to vector from 0, 0.25, 0
    set billboard of {_e} to center
    make {_e} visible through walls
    set display scale of {_e} to vector from 0.75, 0.75, 0.75
    do while {_p} is online:
        wait tick
        make {_e} ride {_p}
        set {_mpbar} to stickbar(getmana({_p})/getstat({_p}, "maxmp")*20, 20, "&b", "&r")
        set {_hpbar} to stickbar(health of {_p}/max health of {_p}*20, 20, "&c", "&r")
        set text of {_e} to "%display name of {_p}%%nl%&cHP %{_hpbar}%%nl%&bMP %{_mpbar}%"
        {_e} is not alive
        stop loop
    kill {_e}

function fakenametag(p: player):
    spawn text display at {_p}
    set {_e} to last spawned entity
    add "nametag" to scoreboard tags of {_e}
    set transformation translation of {_e} to vector from 0, 0.25, 0
    set billboard of {_e} to center
    make {_e} visible through walls
    set display scale of {_e} to vector from 0.75, 0.75, 0.75
    do while {_p} is online:
        wait tick
        make {_e} ride {_p}
        set {_hpbar} to stickbar(health of {_p}/max health of {_p}*20, 20, "&c", "&r")
        set text of {_e} to "%display name of {_p}%%nl%&cHP %{_hpbar}%"
        {_e} is not alive
        stop loop
    kill {_e}

function defset(key: text, type: text, def: object, min: number=0, max: number=0, step: number=1):
    set {setdef::%{_key}%::type} to {_type}
    set {setdef::%{_key}%::def} to {_def}
    set {setdef::%{_key}%::min} to {_min}
    set {setdef::%{_key}%::max} to {_max}
    set {setdef::%{_key}%::step} to {_step}

function defsetopt(key: text, options: texts):
    set {setdef::%{_key}%::options::*} to {_options::*}

function getset(p: player, key: text) :: object:
    if {setting::%uuid of {_p}%::%{_key}%} is set:
        return {setting::%uuid of {_p}%::%{_key}%}
    return {setdef::%{_key}%::def}

function setbool(p: player, key: text) :: boolean:
    set {_v} to getset({_p}, {_key})
    if {_v} is true:
        set {setting::%uuid of {_p}%::%{_key}%} to false
        return false
    set {setting::%uuid of {_p}%::%{_key}%} to true
    return true

function setnum(p: player, key: text, v: number) :: number:
    set {_v} to clamp({_v}, {setdef::%{_key}%::min}, {setdef::%{_key}%::max})
    set {setting::%uuid of {_p}%::%{_key}%} to {_v}
    return {_v}

function clickmul(ct: click type) :: number:
    if {_ct} is left mouse with shift:
        return 100
    if {_ct} is right mouse button with shift:
        return 1000
    if {_ct} is right mouse button:
        return 10
    return 1

function settingsgui(p: player):
    loop indices of {setdef::*}:
        set {_k} to loop-value
        if {setdef::%{_k}%::type} is "bool":
            set {_v} to getset({_p}, {_k})
            if {_v} is true:
                add lime dye named "%{_k}%" with lore booltext({_v}) to {_i::*}
            else:
                add gray dye named "%{_k}%" with lore booltext({_v}) to {_i::*}
        else if {setdef::%{_k}%::type} is "num":
            set {_v} to getset({_p}, {_k})
            add paper named "%{_k}%" with lore "&f%{_v}%" and "&7min %{setdef::%{_k}%::min}% / max %{setdef::%{_k}%::max}%" to {_i::*}
        else if {setdef::%{_k}%::type} is "opt":
            set {_v} to getset({_p}, {_k})
            add paper named "%{_k}%" with lore "&f%{_v}%" to {_i::*}
    gui({_p}, {_i::*}, "設定メニュー")

on inventory click:
    event-inventory is not player's inventory
    name of event-inventory is "設定メニュー"
    cancel event
    event-item is set
    set {_k} to name of event-item
    {setdef::%{_k}%::type} is set
    if {setdef::%{_k}%::type} is "bool":
        setbool(player, {_k})
    else if {setdef::%{_k}%::type} is "num":
        set {_m} to clickmul(click type) * {setdef::%{_k}%::step}
        if click type is right mouse button:
            set {_m} to {_m} * -1
        if click type is right mouse button with shift:
            set {_m} to {_m} * -1
        setnum(player, {_k}, getset(player, {_k}) + {_m})
    else if {setdef::%{_k}%::type} is "opt":
        set {_o::*} to {setdef::%{_k}%::options::*}
        set {_v} to getset(player, {_k})
        loop {_o::*}:
            if loop-value is {_v}:
                set {_n} to {_o::%loop-counter + 1%}
                if {_n} is not set:
                    set {_n} to {_o::1}
        set {setting::%uuid of player%::%{_k}%} to {_n} if {_n} is set
    wait 1 tick
    settingsgui(player)

function defstat(key: text, base: number, name: text=""):
    set {statdef::%{_key}%::base} to {_base}
    if {_name} is not "":
        set {statdef::%{_key}%::name} to {_name}

function statname(key: text) :: text:
    if {statdef::%{_key}%::name} is set:
        return {statdef::%{_key}%::name}
    return {_key}

function addstatmod(p: player, key: text, source: text, amount: number):
    if {statdef::%{_key}%::base} is not set:
        logging("未定義のステータスです: %{_key}%")
        stop
    set {statmod::%uuid of {_p}%::%{_key}%::%{_source}%} to {_amount}

function delstatmod(p: player, key: text, source: text):
    delete {statmod::%uuid of {_p}%::%{_key}%::%{_source}%}

function getstat(p: player, key: text) :: number:
    set {_b} to {statdef::%{_key}%::base}
    if {_b} is not set:
        logging("未定義のステータスです: %{_key}%")
        set {_b} to 0
    loop indices of {statmod::%uuid of {_p}%::%{_key}%::*}:
        add {statmod::%uuid of {_p}%::%{_key}%::%loop-value%} to {_b}
    return {_b}

function getmana(p: player) :: number:
    if {stat::%uuid of {_p}%::mana} is not set:
        set {stat::%uuid of {_p}%::mana} to getstat({_p}, "maxmp")
    return min({stat::%uuid of {_p}%::mana}, getstat({_p}, "maxmp"))

function usemana(p: player, amount: number) :: boolean:
    if getmana({_p}) < {_amount}:
        play sound "block.fire.extinguish" to {_p} at {_p}
        send title "" with subtitle "&cMPが足りない" to {_p} for 10 tick with fadein 5 tick fadeout 5 tick
        return false
    remove {_amount} from {stat::%uuid of {_p}%::mana}
    return true

function itemstats(i: item) :: objects:
    loop indices of {statdef::*}:
        set {_v} to data tag "stat:%loop-value%" of {_i}
        if {_v} is set:
            add loop-value to {_r::*}
            add {_v} parsed as number to {_r::*}
    return {_r::*}

function statlore(i: item) :: item:
    set {_s::*} to itemstats({_i})
    loop {_s::*}:
        if mod(loop-counter, 2) is 1:
            set {_k} to loop-value
        else:
            set {_v} to loop-value
            set {_kn} to statname({_k})
            add "&7%{_kn}%: &f%signed({_v})%" to {_l::*}
    set {_r} to {_i}
    set lore of {_r} to {_l::*}
    return {_r}

function defbuff(id: text, name: text):
    set {buffdef::%{_id}%::name} to {_name}

function buffmod(id: text, key: text, amount: number):
    set {buffdef::%{_id}%::mods::%{_key}%} to {_amount}

function buffopt(id: text, opt: text, value: object):
    set {buffdef::%{_id}%::opt::%{_opt}%} to {_value}

function givebuff(p: player, id: text, duration: number=-1) :: boolean:
    if {buffdef::%{_id}%::name} is not set:
        logging("未定義のバフです: %{_id}%")
        return false
    set {_dp} to {buffdef::%{_id}%::opt::priority}
    if {_dp} is not set:
        set {_dp} to 0
    set {_rem} to {_duration}
    set {_stack} to 1
    if hasbuff({_p}, {_id}) is true:
        if {buff::%uuid of {_p}%::%{_id}%::priority} > {_dp}:
            return false
        set {_rule} to {buffdef::%{_id}%::opt::stack}
        if {_rule} is "max":
            set {_cur} to {buff::%uuid of {_p}%::%{_id}%}
            if any:
                {_cur} < 0
                {_duration} < 0
            then:
                set {_rem} to -1
            else:
                set {_rem} to max({_cur}, {_duration})
            set {_stack} to buffstack({_p}, {_id})
        else if {_rule} is "stack":
            set {_max} to {buffdef::%{_id}%::opt::maxstack}
            if {_max} is not set:
                set {_max} to 1
            set {_stack} to buffstack({_p}, {_id}) + 1
            if {_stack} > {_max}:
                set {_stack} to {_max}
    clear {buff::%uuid of {_p}%::%{_id}%::stats::*}
    loop indices of {buffdef::%{_id}%::mods::*}:
        set {_amt} to {buffdef::%{_id}%::mods::%loop-value%}
        addstatmod({_p}, loop-value, "buff:%{_id}%", {_amt} * {_stack})
        add loop-value to {buff::%uuid of {_p}%::%{_id}%::stats::*}
    set {buff::%uuid of {_p}%::%{_id}%} to {_rem}
    set {buff::%uuid of {_p}%::%{_id}%::stack} to {_stack}
    set {buff::%uuid of {_p}%::%{_id}%::priority} to {_dp}
    delete {buff::%uuid of {_p}%::%{_id}%::cd}
    if {_rem} is not -1:
        startTask("buff", timespan({_rem} + 40, tick), "buff_%uuid of {_p}%_%{_id}%")
    return true

function buffend(p: player, id: text, reason: text):
    loop {buff::%uuid of {_p}%::%{_id}%::stats::*}:
        delstatmod({_p}, loop-value, "buff:%{_id}%")
    if {buffdef::%{_id}%::opt::end} is true:
        set {_f} to function named "%{_id}%_buffend"
        if {_f} is set:
            run {_f} with arguments {_p} and {_reason}
    delete {buff::%uuid of {_p}%::%{_id}%::*}
    delete {buff::%uuid of {_p}%::%{_id}%}

function delbuff(p: player, id: text) :: boolean:
    if hasbuff({_p}, {_id}) is false:
        return false
    buffend({_p}, {_id}, "removed")
    return true

function clearbuffs(p: player, kind: text=""):
    loop buffs({_p}):
        set {_bk} to {buffdef::%loop-value%::opt::kind}
        if length of {_kind} is 0:
            buffend({_p}, loop-value, "removed")
        else if {_bk} is {_kind}:
            buffend({_p}, loop-value, "removed")

function hasbuff(p: player, id: text) :: boolean:
    if {buff::%uuid of {_p}%::%{_id}%} is set:
        return true
    return false

function bufftime(p: player, id: text) :: number:
    if {buff::%uuid of {_p}%::%{_id}%} is not set:
        return 0
    return {buff::%uuid of {_p}%::%{_id}%}

function buffstack(p: player, id: text) :: number:
    if {buff::%uuid of {_p}%::%{_id}%} is not set:
        return 0
    set {_s} to {buff::%uuid of {_p}%::%{_id}%::stack}
    if {_s} is not set:
        return 1
    return {_s}

function buffs(p: player) :: texts:
    loop indices of {buff::%uuid of {_p}%::*}:
        add loop-value to {_r::*}
    return {_r::*}

function bufflines(p: player) :: texts:
    loop buffs({_p}):
        set {_t} to {buff::%uuid of {_p}%::%loop-value%}
        if {_t} is -1:
            add {buffdef::%loop-value%::name} to {_r::*}
        else:
            add "%{buffdef::%loop-value%::name}% %dot({_t} / 20)%" to {_r::*}
    return {_r::*}

function Nanatask_buff(id: text) :: boolean:
    set {_u} to subtext of {_id} from 6 to 41
    set {_b} to subtext of {_id} from 43 to length of {_id}
    set {_p} to player({_u})
    if {_p} is not set:
        loop {buff::%{_u}%::%{_b}%::stats::*}:
            delete {statmod::%{_u}%::%loop-value%::buff:%{_b}%}
        delete {buff::%{_u}%::%{_b}%::*}
        delete {buff::%{_u}%::%{_b}%}
        return true
    if {buff::%{_u}%::%{_b}%} is not set:
        return true
    if {buff::%{_u}%::%{_b}%} is -1:
        return true
    add 1 to {buff::%{_u}%::%{_b}%::cd}
    if {buff::%{_u}%::%{_b}%::cd} < 5:
        return false
    set {buff::%{_u}%::%{_b}%::cd} to 0
    add -5 to {buff::%{_u}%::%{_b}%}
    set {_t} to {buffdef::%{_b}%::opt::tick}
    if {_t} is set:
        if {buff::%{_u}%::%{_b}%} > 0:
            if mod({buff::%{_u}%::%{_b}%}, {_t}) is 0:
                set {_f} to function named "%{_b}%_bufftick"
                if {_f} is set:
                    run {_f} with arguments {_p}
    if {buff::%{_u}%::%{_b}%} <= 0:
        buffend({_p}, {_b}, "expired")
        return true
    return false
