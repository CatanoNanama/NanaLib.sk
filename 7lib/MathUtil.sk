function r(n1: number, n2: number,int: boolean=true) :: number:
    return random integer between {_n1} to {_n2} if {_int} is true
    return random number between {_n1} to {_n2} if {_int} is false

function r(o: objects) :: object:
    return random element of {_o::*}

function f(o: objects) :: object:
    return first element of {_o::*}

function l(o: objects) :: object:
    return last element of {_o::*}

function d(l: location, l2: location) :: number:
    return distance between {_l} and {_l2}

function dxz(l: location, l2: location) :: number:
    set {_l}'s y to 1
    set {_l2}'s y to 1
    return distance between {_l} and {_l2}

function floorloc(l: location) :: location:
    add 1 to {_l}'s y
    set {_ray} to ray trace from {_l} along vector(0,-1,0) with max distance 320 while ignoring passable blocks while ignoring entities
    set {_l} to ray trace hit block of {_ray}
    add 0.6 to {_l}'s y
    return {_l}

function sety(v: object ,y: number=0) :: object:
    if {_v} is location:
        set {_v}'s y coord to {_y}
    else if {_v} is vector:
        set {_v}'s y to {_y}
    return {_v}

function addy(v: object, y: number) :: object:
    if {_v} is location:
        add {_y} to {_v}'s y coord
    else if {_v} is vector:
        add {_y} to {_v}'s y
    return {_v}

function ray(p: entity,d: number, e: entities=displays, entity: boolean=true) :: location:
    set {_t} to target entity of {_p} if {_entity} is true
    set {_ray} to raytrace from {_p} with max distance {_d} while ignoring passable blocks while ignoring {_e::*}
    set {_t} to raytrace hit block of {_ray} if {_t} is not set
    set {_t} to {_p}'s head~vector in direction of {_p}*{_d} if {_t} is not set
    return {_t}

function ray(a: location, b: location, step: number=0.5) :: locations:
    set {_ax} to x-coordinate of {_a}
    set {_ay} to y-coordinate of {_a}
    set {_az} to z-coordinate of {_a}
    set {_bx} to x-coordinate of {_b}
    set {_by} to y-coordinate of {_b}
    set {_bz} to z-coordinate of {_b}
    set {_dx} to {_bx} - {_ax}
    set {_dy} to {_by} - {_ay}
    set {_dz} to {_bz} - {_az}
    set {_len} to sqrt({_dx}^2 + {_dy}^2 + {_dz}^2)
    set {_steps} to floor({_len} / {_step})
    set {_locs::*} to {_a}
    loop {_steps} times:
        set {_t} to loop-number / {_steps}
        set {_x} to {_ax} + {_dx} * {_t}
        set {_y} to {_ay} + {_dy} * {_t}
        set {_z} to {_az} + {_dz} * {_t}
        add location at {_x}, {_y}, {_z} in world of {_a} to {_locs::*}
    return {_locs::*}

function cray(a: location, b: location, height: number = -2, step: number = 0.5) :: locations:
    set {_ax} to x-coordinate of {_a}
    set {_ay} to y-coordinate of {_a}
    set {_az} to z-coordinate of {_a}
    set {_bx} to x-coordinate of {_b}
    set {_by} to y-coordinate of {_b}
    set {_bz} to z-coordinate of {_b}
    set {_cx} to ({_ax} + {_bx}) / 2
    set {_cy} to (max({_ay}, {_by})) + {_height}
    set {_cz} to ({_az} + {_bz}) / 2
    set {_len} to distance between {_a} and {_b}
    set {_steps} to floor({_len} / {_step})
    set {_locs::*} to {_a}
    loop {_steps} times:
        set {_t} to loop-number / {_steps}
        set {_invT} to 1 - {_t}
        set {_x} to {_invT}^2 * {_ax} + 2 * {_invT} * {_t} * {_cx} + {_t}^2 * {_bx}
        set {_y} to {_invT}^2 * {_ay} + 2 * {_invT} * {_t} * {_cy} + {_t}^2 * {_by}
        set {_z} to {_invT}^2 * {_az} + 2 * {_invT} * {_t} * {_cz} + {_t}^2 * {_bz}
        add location at {_x}, {_y}, {_z} in world of {_a} to {_locs::*}
    add {_b} to {_locs::*}
    return {_locs::*}

function conedata(l: location, r: number, angle: number, step: number=0.5) :: locations:
    set {_o} to location at x-coordinate of {_l}, y-coordinate of {_l}, z-coordinate of {_l} in world of {_l}
    set {_o}'s yaw to yaw of {_l}
    set {_o}'s pitch to pitch of {_l}
    set {_ox} to x-coordinate of {_o}
    set {_oy} to y-coordinate of {_o}
    set {_oz} to z-coordinate of {_o}
    set {_dir} to vector from yaw {_o}'s yaw and pitch {_o}'s pitch
    set {_dx} to x of {_dir}
    set {_dy} to y of {_dir}
    set {_dz} to z of {_dir}
    set {_right} to {_dir} rotated around the global y-axis by 90
    set {_rx} to x of {_right}
    set {_ry} to y of {_right}
    set {_rz} to z of {_right}
    set {_tan} to tan({_angle} / 2)
    set {_n} to ceil(2 * {_r} * {_tan} / {_step})
    set {_n} to 1 if {_n} < 1
    set {_rays} to {_n} + 1
    set {_m} to floor({_r} / {_step})
    add {_o} to {_locs::*}
    set {_i} to 0
    loop {_rays} times:
        set {_t} to 2 * {_i} / {_n} - 1
        set {_vx} to {_dx} + {_rx} * {_t} * {_tan}
        set {_vy} to {_dy} + {_ry} * {_t} * {_tan}
        set {_vz} to {_dz} + {_rz} * {_t} * {_tan}
        set {_len} to sqrt({_vx}^2 + {_vy}^2 + {_vz}^2)
        set {_vx} to {_vx} / {_len}
        set {_vy} to {_vy} / {_len}
        set {_vz} to {_vz} / {_len}
        set {_j} to 1
        loop {_m} times:
            set {_s} to {_j} * {_step}
            set {_k} to ceil({_r} / {_s})
            if mod({_i}, {_k}) is 0 or {_i} is {_n}:
                add location at {_ox} + {_vx} * {_s}, {_oy} + {_vy} * {_s}, {_oz} + {_vz} * {_s} in world of {_o} to {_locs::*}
            add 1 to {_j}
        add 1 to {_i}
    return {_locs::*}

function spread(a: integer=1, r: integer=50, c: location=location(0,0,0)) :: locations:
    loop {_a} times:
        set {_v} to cylindrical vector r(0,{_r}), r(180,-180), 0
        set {_l} to {_c}~{_v}
        set y-coord of {_l} to y coord of highest block at {_l}+0.5
        if floorloc({_l}) is not set:
            set {_l} to first element of spread(1,{_r},{_c})
        add {_l} to {_l::*}
    return {_l::*}

function diceroll(m: text, p: player) :: number:
    set {_d::*} to {_m} parsed as "%integer%d%integer%"
    parse error is not set
    {_d::1} <= 100
    loop {_d::1} time:
        add random integer between 1 and {_d::2} to {_r::*}
        add last element of {_r::*} to {_n}
    set {_r} to "&f%{_m}% &6(%{_r::*}% [%{_n}%]) " if {_d::1} is not 1
    set {_r} to "&f%{_m}% &6(%{_r::*}%) " if {_d::1} is 1
    replace all " and " with ", " in {_r}
    replace all ", " with "," in {_r}
    broadcast "%{_p}'s name%&a: %{_r}%"
    return {_n}
